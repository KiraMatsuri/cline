# ====================================================
# TypeScript 编译产物 (避免污染版本控制)
# 在 src/ 和 webview-ui/src/ 下的 .js 文件通常是 .ts 的编译产物
# 例外：根目录脚本 (esbuild.mjs) 等
# ====================================================
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map
# 但保留 .ts 源文件
!src/**/*.ts

# ====================================================
# 临时/意外文件
# ====================================================
utputFormat
*.code-workspace
